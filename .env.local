# CMS Strapi (público; usado en getStaticProps / getServerSideProps)
API_URL=https://cms.somossuyos.com/api

# Microservicio de órdenes (checkout). Obtén la URL real del equipo/DevOps; sin esto el pago no arranca.
MICROSERVICE_URL=

# Wompi — claves de prueba/producción desde el dashboard Wompi
WOMPI_PUBLIC_KEY=
WOMPI_REDIRECT_URL=http://localhost:3000/confirmacion-pago

# Opcional (expuestas en next.config; hoy casi no se usan en código)
WHATSAPP_NUMBER=
NOV_ID=
