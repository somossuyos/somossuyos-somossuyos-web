# =============================================================================
# Somos Suyos — variables de entorno (ejemplo)
# Copia este archivo a `.env.local` y rellena los valores. NO subas `.env*`.
# En producción (Vercel, Docker, etc.) define las mismas claves en el panel.
# =============================================================================

# --- CMS (Strapi u API compatible) ------------------------------------------
# Base URL incluyendo `/api` (ej: https://cms.ejemplo.com/api)
API_URL=

# --- Microservicio de checkout / envíos --------------------------------------
# URL base del servicio (sin barra final opcional)
MICROSERVICE_URL=

# Bearer JWT u otro token para autorizar POST /order hacia el microservicio.
# Solo se usa en el servidor (ruta /api/checkout/order). NO uses NEXT_PUBLIC_*.
MICROSERVICE_BEARER_TOKEN=

# --- Wompi (pagos) ------------------------------------------------------------
# Clave pública del comercio (sandbox o producción)
WOMPI_PUBLIC_KEY=

# URL absoluta de retorno post-pago (debe coincidir con la configurada en Wompi)
WOMPI_REDIRECT_URL=

# --- Opcional (expuestas vía next.config si las defines) ----------------------
WHATSAPP_NUMBER=
NOV_ID=
