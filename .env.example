# =============================================================================
# Somos Suyos — variables de entorno (ejemplo)
# Copia este archivo a `.env.local` y rellena los valores. NO subas `.env*`.
# En producción define las mismas claves en el panel de Amplify.
# =============================================================================

# --- CMS (Strapi u API compatible) ------------------------------------------
API_URL=

# --- App / URLs públicas ------------------------------------------------------
# Origen público del sitio (Amplify URL o dominio). Usado por checkout y redirects.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Wompi (pagos) ------------------------------------------------------------
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_REDIRECT_URL=
# Opcional: para verificación de webhook distinta al integrity (si documentado por Wompi)
WOMPI_EVENTS_SECRET=

# Solo desarrollo: permite webhooks sin verificar firma (NO uses en prod)
WOMPI_WEBHOOK_DISABLE_VERIFY=

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Secreto compartido para POST /api/send-confirmation-email (pruebas manuales)
INTERNAL_MAIL_SECRET=

# --- Opcional (expuestas vía next.config si las defines) ----------------------
WHATSAPP_NUMBER=
NOV_ID=
