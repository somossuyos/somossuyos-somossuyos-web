# =============================================================================
# Somos Suyos — variables de entorno (ejemplo)
# Copia este archivo a `.env.local` y rellena los valores. NO subas `.env*`.
# En producción define las mismas claves en el panel de Amplify.
# =============================================================================

# --- CMS (Strapi u API compatible) ------------------------------------------
API_URL=

# --- App / URLs públicas ------------------------------------------------------
NEXT_PUBLIC_BASE_URL=https://www.somossuyos.com

# --- Wompi (pagos) ------------------------------------------------------------
WOMPI_PUBLIC_KEY=
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_REDIRECT_URL=https://www.somossuyos.com/confirmacion-pago
NEXT_PUBLIC_WOMPI_REDIRECT_URL=
WOMPI_DEBUG_ENV=
WOMPI_WEBHOOK_DISABLE_VERIFY=
WOMPI_DIGITAL_PDF_URL=
WOMPI_DIGITAL_PRODUCT_NAME=Novena E.S. Digital

# --- Email (Resend) — producción ----------------------------------------------
# Key "Sending access" de la cuenta donde el dominio está Verified.
RESEND_API_KEY=
# Obligatorio: dominio verificado en Resend (updates.somossuyos.com).
# Si pones @somossuyos.com, el código lo corrige a @updates.somossuyos.com.
RESEND_FROM_EMAIL=contacto@updates.somossuyos.com
INTERNAL_MAIL_SECRET=

# --- Opcional -----------------------------------------------------------------
# Meta Pixel (también definido en src/lib/analytics/metaPixel.ts)
NEXT_PUBLIC_META_PIXEL_ID=797623582261445
# Microsoft Clarity (src/lib/analytics/clarity.ts)
NEXT_PUBLIC_CLARITY_PROJECT_ID=wtojh3ewr0
WHATSAPP_NUMBER=
NOV_ID=

# =============================================================================
# Amplify: amplify.yml copia estas variables a .env.production antes del build.
# Wompi webhook URL: https://www.somossuyos.com/api/wompi/webhook
# =============================================================================
