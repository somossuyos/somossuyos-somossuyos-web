# =============================================================================
# Somos Suyos — variables de entorno (ejemplo)
# Copia este archivo a `.env.local` y rellena los valores. NO subas `.env*`.
# En producción define las mismas claves en el panel de Amplify.
# =============================================================================

# --- CMS (Strapi u API compatible) ------------------------------------------
API_URL=

# --- App / URLs públicas ------------------------------------------------------
# Origen público del sitio (Amplify URL o dominio). Usado por checkout y redirects.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Wompi (pagos) ------------------------------------------------------------
# Clave pública de comercio (no es secreta). El widget en el navegador la necesita.
# Puedes definir solo WOMPI_PUBLIC_KEY o solo NEXT_PUBLIC_WOMPI_PUBLIC_KEY; el
# proyecto acepta ambos (next.config duplica el valor para el cliente si hace falta).
WOMPI_PUBLIC_KEY=
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=

# Secreto de integridad del widget / web checkout (SOLO servidor; nunca NEXT_PUBLIC_*).
WOMPI_INTEGRITY_SECRET=

# Clave privada (solo servidor; reservada para API merchant si la usas).
WOMPI_PRIVATE_KEY=

# Secreto para validar webhooks (solo servidor).
WOMPI_EVENTS_SECRET=

# URL a la que Wompi redirige tras el pago (pública). Opcional: duplicar como
# NEXT_PUBLIC_WOMPI_REDIRECT_URL para el build del cliente.
WOMPI_REDIRECT_URL=
NEXT_PUBLIC_WOMPI_REDIRECT_URL=

# Opcional: en producción pon `true` solo mientras depuras; enmascara valores en logs.
WOMPI_DEBUG_ENV=

# Solo desarrollo: permite webhooks sin verificar firma (NO uses en prod)
WOMPI_WEBHOOK_DISABLE_VERIFY=

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Secreto compartido para POST /api/send-confirmation-email (pruebas manuales)
INTERNAL_MAIL_SECRET=

# --- Opcional (expuestas vía next.config si las defines) ----------------------
WHATSAPP_NUMBER=
NOV_ID=

# =============================================================================
# AWS Amplify (Next.js SSR)
# Las variables del panel de Amplify llegan al entorno de *build*, pero el runtime
# de las API routes (Lambda) no las ve por defecto. Este repo incluye `amplify.yml`
# que copia WOMPI_*, API_URL, Resend, etc. y todo `NEXT_PUBLIC_*` a `.env.production`
# antes de `npm run build`. No subas `.env.production` (está en .gitignore).
# Ref: https://docs.aws.amazon.com/amplify/latest/userguide/ssr-environment-variables.html
# =============================================================================
